# Server-side env for the Next.js app (never expose these to the browser).
# Copy to frontend/.env and adjust for your machine.

# Backend API base URL. The /api/proxy route forwards requests here.
AGENCY_API_URL=http://localhost:8000/api

# Shared bearer token. Optional once JWT auth is live: the proxy forwards the
# browser's Authorization header to the API. API_TOKEN is used as a fallback
# for server-side calls that have no per-user session.
API_TOKEN=replace-with-your-backend-API_TOKEN

# Google OAuth client ID (public). Required for "Continue with Google".
# MUST be set at build time, so set it in the Vercel project env vars too.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
