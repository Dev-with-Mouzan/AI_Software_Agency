# Copy to .env on the EC2 host and fill in real values.
# Every value here is required by docker-compose.yml unless marked optional.

# --- Database ---
POSTGRES_PASSWORD=change-me-strong-password

# --- API auth (must match the token the Vercel frontend uses) ---
API_TOKEN=change-me-shared-secret

# Optional: comma-separated origins allowed to call the API directly.
# Example: API_CORS_ORIGINS=https://agency.example.com
API_CORS_ORIGINS=

# --- LLM providers (mirror of the values in E:\Agencie\.env) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_AGENTS=["planner","backend_engineer","frontend_engineer","devops_engineer","code_reviewer"]

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash

# Per-agent routing override, e.g.
# AGENT_MODELS={"planner":{"provider":"deepseek","model":"deepseek-v4-flash"}}
AGENT_MODELS=
