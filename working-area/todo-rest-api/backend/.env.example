# Copy to .env and adjust for your environment. Never commit .env.

# development | test | production
NODE_ENV=development

# Interface the API binds to
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string (used by Prisma at runtime and by migrate)
DATABASE_URL=postgresql://todo:todo@localhost:5432/todo

# Comma-separated list of allowed CORS origins (dev Vite server default)
CORS_ORIGIN=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Global per-IP rate limit (requests per 15 minutes)
RATE_LIMIT_MAX=300
